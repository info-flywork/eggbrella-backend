{
  "name": "eggbrella-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Eggbrella oyunu REST API (Express + mysql2, CommonJS)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "find src scripts test migrations -name '*.js' -print0 | xargs -0 -n1 node --check && node --check ecosystem.config.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.6",
    "winston": "^3.19.0"
  }
}
