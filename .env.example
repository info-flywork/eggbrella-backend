# --- Sunucu ---
NODE_ENV=production
# Her API'ye benzersiz port; sunucuda `sudo ss -tlnp` ile çakışmayı kontrol edin.
PORT=3082
HOST=127.0.0.1
LOG_LEVEL=info
CORS_ORIGIN=*
TRUST_PROXY=loopback

# --- Veritabanı (MariaDB / MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_LIMIT=5

# --- Kimlik (JWT HS256) ---
# En az 32 karakter: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL_DAYS=90

# --- Bunny CDN (paylaşım klipleri) ---
# Storage zone adı ve FTP & API Access > Password. Bölgesel zone ise host: <bölge>.storage.bunnycdn.com
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
# Pull zone adresi (sonda / olmadan)
BUNNY_CDN_BASE_URL=https://eggbrella.b-cdn.net
CLIP_MAX_BYTES=15728640
CLIP_DAILY_LIMIT=30

# RevenueCat (coin paketleri sunucuda yüklenir)
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
